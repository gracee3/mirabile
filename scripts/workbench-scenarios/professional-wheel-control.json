{
  "name": "professional-wheel-control",
  "steps": [
    {"command": "wait", "timeout": 20},
    {"command": "get", "address": "surface.workspace", "expect": {"kind": "action", "enabled": true}},
    {"command": "get", "address": "surface.inspector", "expect": {"kind": "action", "enabled": true}},
    {"command": "get", "address": "surface.cockpit", "expect": {"kind": "action", "enabled": true}},
    {"command": "get", "address": "surface.diagnostics", "expect": {"kind": "action", "enabled": true}},
    {"command": "click", "address": "workspace.load-demo"},
    {"command": "wait", "timeout": 20},
    {"command": "click", "address": "workspace.open[resource=14000000-0000-4000-8000-000000000001]"},
    {"command": "click", "address": "workspace.switch-discard"},
    {"command": "wait", "timeout": 20},
    {"command": "snapshot", "expect": {"value.chart.title": "Example Natal", "value.view.computation": "fresh", "value.view.scene_manifest.zodiac_count": 12, "value.view.scene_manifest.house_count": 12, "value.view.scene_manifest.angle_count": 4, "value.view.scene_manifest.point_count": 6, "value.view.scene_manifest.aspect_count": 1, "value.view.scene_manifest.zodiac_ids.0": "aries", "value.view.scene_manifest.zodiac_ids.11": "pisces", "value.view.scene_manifest.angles.0.id": "asc", "value.view.scene_manifest.angles.1.derived_opposite": true, "value.view.scene_manifest.points.0.glyph_fallback": false, "value.view.scene_manifest.aspects.0.aspect_id": "square", "value.view.scene_manifest.aspects.0.chord": true}},
    {"command": "layout", "expect": {"horizontalOverflow": false, "wheelPresent": true, "wheelVisible": true, "wheelWithinFrame": true, "pointLabelsInsideFrame": true, "pointLabelOverlapCount": 0, "wheelCentered": true, "wheelDominant": true, "firstSurfaceIsWheel": true, "titlePresent": true, "descriptionPresent": true, "zodiacCount": 12, "houseCount": 12, "angleCount": 4, "pointAnchorCount": 6, "pointLabelCount": 6, "retrogradeMarkerCount": 0, "aspectCount": 1, "semanticGroupCount": 6, "disclosureCount": 4, "closedDisclosureCount": 2}},
    {"command": "click", "address": "surface.inspector"},
    {"command": "click", "address": "chart.edit-saved"},
    {"command": "wait", "timeout": 20},
    {"command": "get", "address": "chart.houses", "expect": {"kind": "select", "value": "equal", "options.0.enabled": true, "options.1.enabled": true, "options.2.enabled": true}},
    {"command": "select", "address": "chart.houses", "value": "no_houses"},
    {"command": "wait", "timeout": 20},
    {"command": "snapshot", "expect": {"value.view.computation": "fresh", "value.view.scene_manifest.zodiac_count": 12, "value.view.scene_manifest.house_count": 0, "value.view.scene_manifest.point_count": 6}},
    {"command": "select", "address": "chart.houses", "value": "equal"},
    {"command": "wait", "timeout": 20},
    {"command": "snapshot", "expect": {"value.view.computation": "fresh", "value.view.scene_manifest.house_count": 12, "value.semantic_output.houses.0.number": 1, "value.semantic_output.houses.11.number": 12}},
    {"command": "select", "address": "chart.houses", "value": "placidus"},
    {"command": "wait", "timeout": 20},
    {"command": "snapshot", "expect": {"value.view.computation": "fresh", "value.view.scene_manifest.house_count": 12, "value.semantic_output.houses.0.number": 1, "value.semantic_output.houses.11.number": 12}},
    {"command": "click", "address": "chart.editor-cancel"},
    {"command": "wait", "timeout": 20},
    {"command": "click", "address": "chart.open[definition=12000000-0000-4000-8000-000000000002]"},
    {"command": "wait", "timeout": 20},
    {"command": "snapshot", "bind": "event_instance", "bind_path": "value.chart.instance_id", "expect": {"value.chart.title": "Example Event"}},
    {"command": "select", "address": "view.slot[slot=radix,view=16000000-0000-4000-8000-000000000001]", "value": "${event_instance}"},
    {"command": "wait", "timeout": 20},
    {"command": "snapshot", "expect": {"value.chart.title": "Example Event", "value.view.computation": "fresh", "value.view.scene_manifest.zodiac_count": 12, "value.view.scene_manifest.house_count": 12, "value.view.scene_manifest.angle_count": 4, "value.view.scene_manifest.point_count": 6, "value.view.scene_manifest.aspect_count": 2, "value.view.scene_manifest.points.1.point_id": "jupiter", "value.view.scene_manifest.points.1.retrograde": true, "value.view.scene_manifest.points.1.retrograde_marker": true, "value.view.scene_manifest.aspects.0.aspect_id": "conjunction", "value.view.scene_manifest.aspects.0.chord": false, "value.view.scene_manifest.aspects.1.aspect_id": "conjunction", "value.view.scene_manifest.aspects.1.chord": false}},
    {"command": "layout", "expect": {"horizontalOverflow": false, "wheelVisible": true, "wheelWithinFrame": true, "pointLabelsInsideFrame": true, "pointLabelOverlapCount": 0, "wheelCentered": true, "wheelDominant": true, "titlePresent": true, "descriptionPresent": true, "zodiacCount": 12, "houseCount": 12, "angleCount": 4, "pointAnchorCount": 6, "pointLabelCount": 6, "retrogradeMarkerCount": 1, "aspectCount": 2, "semanticGroupCount": 6}},
    {"command": "click", "address": "surface.diagnostics"},
    {"command": "get", "address": "diagnostics.export-snapshot", "expect": {"kind": "action", "enabled": true}},
    {"command": "browser_errors", "expect": {"count": 0}}
  ]
}
