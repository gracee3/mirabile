{
  "name": "new-chart-control",
  "steps": [
    {"command": "wait", "timeout": 15},
    {"command": "click", "address": "chart.new"},
    {"command": "wait", "timeout": 15},
    {"command": "get", "address": "chart.new", "expect": {"kind": "action"}},
    {"command": "get", "address": "chart.title", "expect": {"kind": "text", "value": "Untitled Chart", "local_buffer": null, "locked": true, "editing": false, "invalid": false}},
    {"command": "get", "address": "chart.civil-date", "expect": {"kind": "date"}},
    {"command": "get", "address": "chart.civil-time", "expect": {"kind": "time"}},
    {"command": "get", "address": "chart.location-enabled", "expect": {"kind": "toggle"}},
    {"command": "get", "address": "chart.event-kind", "expect": {"kind": "select"}},
    {"command": "get", "address": "chart.editor-save", "expect": {"kind": "action"}},
    {"command": "get", "address": "chart.houses", "expect": {"kind": "select", "options.1.enabled": false, "options.1.disabled_reason": "A complete manual location is required for houses"}},
    {"command": "click", "address": "chart.title"},
    {"command": "get", "address": "chart.title", "expect": {"kind": "text", "value": "Untitled Chart", "local_buffer": "Untitled Chart", "locked": false, "editing": true, "invalid": false}},
    {"command": "set", "address": "chart.title", "value": "Control Natal"},
    {"command": "get", "address": "chart.title", "expect": {"value": "Untitled Chart", "local_buffer": "Control Natal", "locked": false, "editing": true, "invalid": false}},
    {"command": "key", "address": "chart.title", "key": "Enter"},
    {"command": "wait", "timeout": 15},
    {"command": "get", "address": "chart.title", "expect": {"kind": "text", "value": "Control Natal", "local_buffer": null, "locked": true, "editing": false, "invalid": false}},
    {"command": "click", "address": "chart.location-enabled"},
    {"command": "wait", "timeout": 15},
    {"command": "get", "address": "chart.editor-save", "expect": {"kind": "action", "enabled": false, "disabled_reason": "Complete every invalid chart field before saving"}},
    {"command": "get", "address": "chart.latitude", "expect": {"kind": "number", "value": "", "local_buffer": null, "locked": true}},
    {"command": "get", "address": "chart.longitude", "expect": {"kind": "number", "value": "", "local_buffer": null, "locked": true}},
    {"command": "click", "address": "chart.location-name"},
    {"command": "set", "address": "chart.location-name", "value": "Baltimore"},
    {"command": "key", "address": "chart.location-name", "key": "Enter"},
    {"command": "click", "address": "chart.latitude"},
    {"command": "set", "address": "chart.latitude", "value": "999"},
    {"command": "key", "address": "chart.latitude", "key": "Enter"},
    {"command": "get", "address": "chart.latitude", "expect": {"kind": "number", "value": "", "invalid": true, "editing": true, "locked": false, "local_buffer": "999"}},
    {"command": "key", "address": "chart.latitude", "key": "Escape"},
    {"command": "get", "address": "chart.latitude", "expect": {"kind": "number", "value": "", "invalid": false, "editing": false, "locked": true, "local_buffer": null}},
    {"command": "click", "address": "chart.latitude"},
    {"command": "set", "address": "chart.latitude", "value": "39.2904"},
    {"command": "key", "address": "chart.latitude", "key": "Enter"},
    {"command": "wait", "timeout": 15},
    {"command": "get", "address": "chart.latitude", "expect": {"kind": "number", "value": "39.2904", "invalid": false, "editing": false, "locked": true, "local_buffer": null}},
    {"command": "click", "address": "chart.longitude"},
    {"command": "set", "address": "chart.longitude", "value": "-76.6122"},
    {"command": "key", "address": "chart.longitude", "key": "Enter"},
    {"command": "wait", "timeout": 15},
    {"command": "click", "address": "chart.subject-name"},
    {"command": "set", "address": "chart.subject-name", "value": "Example Person"},
    {"command": "key", "address": "chart.subject-name", "key": "Enter"},
    {"command": "set", "address": "chart.subject-pronouns", "value": "they/them"},
    {"command": "set", "address": "chart.custom-event-kind", "value": "Commissioning"},
    {"command": "select", "address": "chart.calendar", "value": "julian"},
    {"command": "select", "address": "chart.disambiguation", "value": "later"},
    {"command": "set", "address": "chart.country-region", "value": "US-MD"},
    {"command": "set", "address": "chart.atlas-provider", "value": "Test Atlas"},
    {"command": "set", "address": "chart.atlas-record", "value": "BAL-1"},
    {"command": "set", "address": "chart.atlas-version", "value": "2026"},
    {"command": "set", "address": "chart.source-description", "value": "Verified browser fixture"},
    {"command": "select", "address": "chart.source-type", "value": "research"},
    {"command": "set", "address": "chart.source-recorded-by", "value": "E2E"},
    {"command": "select", "address": "chart.houses", "value": "equal"},
    {"command": "wait", "timeout": 15},
    {"command": "click", "address": "chart.editor-save"},
    {"command": "wait", "timeout": 15},
    {"command": "snapshot", "expect": {"value.chart.saved": true, "value.chart.title": "Control Natal", "value.chart_editor": null}},
    {"command": "trace"}
  ]
}
