{
  "name": "nested-macro-control",
  "steps": [
    {"command": "wait", "timeout": 15},
    {"command": "set", "address": "macro.name", "value": "Nested structural builders"},
    {"command": "click", "address": "macro.start"},
    {"command": "click", "address": "resource.new[kind=pointset]"},
    {"command": "set", "address": "resource.title[kind=pointset]", "value": "Macro structural points"},
    {"command": "check", "address": "resource.point[kind=pointset,point=sun]", "value": true},
    {"command": "check", "address": "resource.point[kind=pointset,point=moon]", "value": true},
    {"command": "check", "address": "resource.point[kind=pointset,point=sun]", "value": false},
    {"command": "click", "address": "resource.save[kind=pointset]"},
    {"command": "wait", "timeout": 15},
    {"command": "click", "address": "resource.new[kind=querydefinition]"},
    {"command": "set", "address": "resource.title[kind=querydefinition]", "value": "Macro structural query"},
    {"command": "discover", "control": "resource.query.node", "qualifiers": {"kind": "querydefinition", "collection": "tree", "field": "type"}, "bind": "query_root"},
    {"command": "select", "address": "${query_root}", "value": "and"},
    {"command": "discover", "control": "resource.query.insert", "qualifiers": {"kind": "querydefinition", "collection": "tree"}, "bind": "query_add"},
    {"command": "click", "address": "${query_add}"},
    {"command": "discover", "control": "resource.query.node", "qualifiers": {"kind": "querydefinition", "collection": "tree", "field": "type"}, "index": 1, "bind": "query_child"},
    {"command": "select", "address": "${query_child}", "value": "aspect"},
    {"command": "discover", "control": "resource.query.node", "qualifiers": {"kind": "querydefinition", "collection": "tree", "field": "lhs"}, "bind": "query_lhs"},
    {"command": "click", "address": "${query_lhs}"},
    {"command": "set", "address": "${query_lhs}", "value": "venus"},
    {"command": "key", "address": "${query_lhs}", "key": "Enter"},
    {"command": "click", "address": "resource.save[kind=querydefinition]"},
    {"command": "wait", "timeout": 15},
    {"command": "click", "address": "macro.stop"},
    {"command": "get", "address": "macro.json", "expect": {"enabled": true, "invalid": false}},
    {"command": "click", "address": "macro.replay"},
    {"command": "wait", "timeout": 20},
    {"command": "snapshot", "expect": {"value.coordinator.running": false, "value.coordinator.macro_state.state": "idle"}},
    {"command": "trace"}
  ]
}
