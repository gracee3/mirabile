{
  "name": "workspace-lifecycle-control",
  "steps": [
    {"command": "wait", "timeout": 15},
    {"command": "click", "address": "workspace.load-demo"},
    {"command": "wait", "timeout": 15},
    {"command": "snapshot", "expect": {"value.workspace.title": "Untitled Workspace", "value.workspace.revision": null}},
    {"command": "click", "address": "workspace.open"},
    {"command": "get", "address": "workspace.switch-save", "expect": {"enabled": false}},
    {"command": "click", "address": "workspace.switch-stay"},
    {"command": "snapshot", "expect": {"value.workspace.title": "Untitled Workspace"}},
    {"command": "click", "address": "workspace.open"},
    {"command": "click", "address": "workspace.switch-discard"},
    {"command": "wait", "timeout": 15},
    {"command": "snapshot", "expect": {"value.workspace.title": "Mirabile Workspace", "value.workspace.revision": 1}},
    {"command": "click", "address": "workspace.title"},
    {"command": "set", "address": "workspace.title", "value": "Browser Workspace Revised"},
    {"command": "key", "address": "workspace.title", "key": "Enter"},
    {"command": "set", "address": "workspace.description", "value": "Workspace browser metadata"},
    {"command": "set", "address": "workspace.tags", "value": "duplicate, duplicate"},
    {"command": "wait"},
    {"command": "get", "address": "workspace.save", "expect": {"enabled": false, "disabled_reason": "Complete every invalid workspace field before saving"}},
    {"command": "set", "address": "workspace.tags", "value": "workspace, browser"},
    {"command": "wait"},
    {"command": "click", "address": "workspace.new"},
    {"command": "get", "address": "workspace.switch-save", "expect": {"enabled": true}},
    {"command": "click", "address": "workspace.switch-save"},
    {"command": "wait", "timeout": 15},
    {"command": "snapshot", "expect": {"value.workspace.title": "Untitled Workspace", "value.workspace.revision": null}},
    {"command": "click", "address": "workspace.open"},
    {"command": "click", "address": "workspace.switch-discard"},
    {"command": "wait", "timeout": 15},
    {"command": "snapshot", "expect": {"value.workspace.title": "Browser Workspace Revised", "value.workspace.revision": 2}},
    {"command": "get", "address": "workspace.description", "expect": {"value": "Workspace browser metadata"}},
    {"command": "get", "address": "workspace.tags", "expect": {"value": "workspace, browser"}},
    {"command": "click", "address": "workspace.title"},
    {"command": "set", "address": "workspace.title", "value": "Discard This Title"},
    {"command": "key", "address": "workspace.title", "key": "Enter"},
    {"command": "click", "address": "workspace.discard"},
    {"command": "wait", "timeout": 15},
    {"command": "snapshot", "expect": {"value.workspace.title": "Browser Workspace Revised", "value.workspace.dirty": false, "value.workspace.revision": 2}},
    {"command": "trace"}
  ]
}
