{
  "name": "history-delete-control",
  "steps": [
    {"command": "wait", "timeout": 20},
    {"command": "click", "address": "workspace.load-demo"},
    {"command": "wait", "timeout": 20},
    {"command": "click", "address": "workspace.open[resource=14000000-0000-4000-8000-000000000001]"},
    {"command": "click", "address": "workspace.switch-discard"},
    {"command": "wait", "timeout": 20},
    {"command": "click", "address": "repository.select[resource=13000000-0000-4000-8000-000000000001]"},
    {"command": "wait"},
    {"command": "get", "address": "repository.delete", "expect": {"enabled": false, "disabled_reason": "Active workspace session binds this resource; Workspace 'Mirabile Workspace' binds this resource"}},
    {"command": "select", "address": "binding.resource[slot=aspects]", "value": "13000000-0000-4000-8000-000000000002"},
    {"command": "wait", "timeout": 20},
    {"command": "click", "address": "workspace.save"},
    {"command": "wait", "timeout": 20},
    {"command": "click", "address": "repository.select[resource=13000000-0000-4000-8000-000000000001]"},
    {"command": "wait"},
    {"command": "get", "address": "repository.delete", "expect": {"enabled": true}},
    {"command": "get", "address": "repository.confirm-delete", "expect": {"enabled": false, "disabled_reason": "First deletion confirmation is required"}},
    {"command": "click", "address": "repository.delete"},
    {"command": "get", "address": "repository.confirm-delete", "expect": {"enabled": true}},
    {"command": "click", "address": "repository.confirm-delete"},
    {"command": "wait", "timeout": 20},
    {"command": "get", "address": "repository.delete", "expect": {"enabled": false, "disabled_reason": "Select a present resource before deletion"}},
    {"command": "reload"},
    {"command": "wait", "timeout": 20},
    {"command": "click", "address": "repository.select[resource=13000000-0000-4000-8000-000000000001]"},
    {"command": "get", "address": "repository.delete", "expect": {"enabled": false, "disabled_reason": "Select a present resource before deletion"}},
    {"command": "snapshot", "expect": {"value.application.status": "ready", "value.application.settled": true}}
  ]
}
