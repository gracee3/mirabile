{
  "name": "nested-builder-control",
  "steps": [
    {"command": "wait", "timeout": 20},
    {"command": "click", "address": "workspace.load-demo"},
    {"command": "wait", "timeout": 20},

    {"command": "click", "address": "resource.new[kind=wheeltemplate]"},
    {"command": "click", "address": "resource.list.insert[collection=rings,kind=wheeltemplate]"},
    {"command": "discover", "control": "resource.list.field", "qualifiers": {"kind": "wheeltemplate", "collection": "rings", "field": "slot"}, "bind": "ring_slot"},
    {"command": "click", "address": "${ring_slot}"},
    {"command": "set", "address": "${ring_slot}", "value": "outer"},
    {"command": "key", "address": "${ring_slot}", "key": "Enter"},
    {"command": "discover", "control": "resource.list.field", "qualifiers": {"kind": "wheeltemplate", "collection": "rings", "field": "inner-radius"}, "bind": "ring_inner"},
    {"command": "click", "address": "${ring_inner}"},
    {"command": "set", "address": "${ring_inner}", "value": "0.6"},
    {"command": "key", "address": "${ring_inner}", "key": "Enter"},
    {"command": "click", "address": "resource.save[kind=wheeltemplate]"},
    {"command": "wait", "timeout": 20},

    {"command": "click", "address": "resource.new[kind=viewdocument]"},
    {"command": "set", "address": "resource.title[kind=viewdocument]", "value": "All View Objects"},
    {"command": "click", "address": "resource.list.insert[collection=chart-slots,kind=viewdocument]"},
    {"command": "select", "address": "resource.list.insert[collection=objects,kind=viewdocument]", "value": "point-table"},
    {"command": "wait"},
    {"command": "discover", "control": "resource.list.field", "qualifiers": {"kind": "viewdocument", "collection": "objects", "field": "width"}, "bind": "object_width"},
    {"command": "click", "address": "${object_width}"},
    {"command": "set", "address": "${object_width}", "value": "512"},
    {"command": "key", "address": "${object_width}", "key": "Enter"},
    {"command": "discover", "control": "resource.list.insert", "qualifiers": {"kind": "viewdocument", "collection": "point-table-points"}, "bind": "point_insert"},
    {"command": "click", "address": "${point_insert}"},
    {"command": "wait"},
    {"command": "click", "address": "${point_insert}"},
    {"command": "wait"},
    {"command": "click", "address": "${point_insert}"},
    {"command": "wait"},
    {"command": "discover", "control": "resource.list.field", "qualifiers": {"kind": "viewdocument", "collection": "point-table-points", "field": "point"}, "index": 0, "bind": "point_0"},
    {"command": "discover", "control": "resource.list.field", "qualifiers": {"kind": "viewdocument", "collection": "point-table-points", "field": "point"}, "index": 1, "bind": "point_1"},
    {"command": "discover", "control": "resource.list.field", "qualifiers": {"kind": "viewdocument", "collection": "point-table-points", "field": "point"}, "index": 2, "bind": "point_2"},
    {"command": "select", "address": "${point_0}", "value": "sun"},
    {"command": "select", "address": "${point_1}", "value": "moon"},
    {"command": "select", "address": "${point_2}", "value": "mars"},
    {"command": "select", "address": "resource.list.insert[collection=objects,kind=viewdocument]", "value": "wheel"},
    {"command": "wait"},
    {"command": "select", "address": "resource.list.insert[collection=objects,kind=viewdocument]", "value": "aspect-grid"},
    {"command": "wait"},
    {"command": "select", "address": "resource.list.insert[collection=objects,kind=viewdocument]", "value": "chart-details"},
    {"command": "wait"},
    {"command": "select", "address": "resource.list.insert[collection=objects,kind=viewdocument]", "value": "aspect-table"},
    {"command": "wait"},
    {"command": "select", "address": "resource.list.insert[collection=objects,kind=viewdocument]", "value": "text"},
    {"command": "wait"},
    {"command": "discover", "control": "resource.list.field", "qualifiers": {"kind": "viewdocument", "collection": "objects", "field": "variant"}, "index": 5, "bind": "sixth_object"},
    {"command": "get", "address": "${sixth_object}"},
    {"command": "click", "address": "resource.save[kind=viewdocument]"},
    {"command": "wait", "timeout": 20},
    {"command": "reload"},
    {"command": "wait", "timeout": 20},
    {"command": "discover", "control": "resource.edit", "qualifiers": {"kind": "viewdocument"}, "index": 0, "bind": "saved_view_edit"},
    {"command": "click", "address": "${saved_view_edit}"},
    {"command": "wait"},
    {"command": "discover", "control": "resource.title", "qualifiers": {"kind": "viewdocument"}, "bind": "saved_view_title"},
    {"command": "get", "address": "${saved_view_title}", "expect": {"value": "All View Objects"}},
    {"command": "discover", "control": "resource.list.field", "qualifiers": {"kind": "viewdocument", "collection": "objects", "field": "variant"}, "index": 5, "bind": "reloaded_sixth_object"},
    {"command": "get", "address": "${reloaded_sixth_object}"},
    {"command": "discover", "control": "resource.list.field", "qualifiers": {"kind": "viewdocument", "collection": "point-table-points", "field": "point"}, "index": 2, "bind": "reloaded_third_point"},
    {"command": "get", "address": "${reloaded_third_point}"},
    {"command": "discover", "control": "resource.cancel", "qualifiers": {"kind": "viewdocument"}, "bind": "saved_view_cancel"},
    {"command": "click", "address": "${saved_view_cancel}"},

    {"command": "click", "address": "resource.new[kind=querydefinition]"},
    {"command": "discover", "control": "resource.query.node", "qualifiers": {"kind": "querydefinition", "collection": "tree", "field": "type"}, "bind": "query_root"},
    {"command": "select", "address": "${query_root}", "value": "and"},
    {"command": "wait"},
    {"command": "discover", "control": "resource.query.insert", "qualifiers": {"kind": "querydefinition", "collection": "tree"}, "bind": "query_add"},
    {"command": "click", "address": "${query_add}"},
    {"command": "wait"},
    {"command": "discover", "control": "resource.query.node", "qualifiers": {"kind": "querydefinition", "collection": "tree", "field": "type"}, "index": 1, "bind": "query_child"},
    {"command": "select", "address": "${query_child}", "value": "aspect"},
    {"command": "wait"},
    {"command": "discover", "control": "resource.query.node", "qualifiers": {"kind": "querydefinition", "collection": "tree", "field": "lhs"}, "bind": "query_lhs"},
    {"command": "click", "address": "${query_lhs}"},
    {"command": "set", "address": "${query_lhs}", "value": "venus"},
    {"command": "key", "address": "${query_lhs}", "key": "Enter"},
    {"command": "discover", "control": "resource.query.node", "qualifiers": {"kind": "querydefinition", "collection": "tree", "field": "orb"}, "bind": "query_orb"},
    {"command": "click", "address": "${query_orb}"},
    {"command": "set", "address": "${query_orb}", "value": "3.5"},
    {"command": "key", "address": "${query_orb}", "key": "Enter"},
    {"command": "click", "address": "resource.save[kind=querydefinition]"},
    {"command": "wait", "timeout": 20},

    {"command": "click", "address": "resource.new[kind=chartdefinition]"},
    {"command": "set", "address": "resource.title[kind=chartdefinition]", "value": "Cockpit Transit"},
    {"command": "click", "address": "resource.recipe.field[field=date,kind=chartdefinition]"},
    {"command": "set", "address": "resource.recipe.field[field=date,kind=chartdefinition]", "value": "2027-04-05"},
    {"command": "key", "address": "resource.recipe.field[field=date,kind=chartdefinition]", "key": "Enter"},
    {"command": "click", "address": "resource.recipe.field[field=time,kind=chartdefinition]"},
    {"command": "set", "address": "resource.recipe.field[field=time,kind=chartdefinition]", "value": "14:30:00"},
    {"command": "key", "address": "resource.recipe.field[field=time,kind=chartdefinition]", "key": "Enter"},
    {"command": "select", "address": "resource.recipe.field[field=calendar,kind=chartdefinition]", "value": "historical"},
    {"command": "wait"},
    {"command": "click", "address": "resource.recipe.field[field=calendar-identifier,kind=chartdefinition]"},
    {"command": "set", "address": "resource.recipe.field[field=calendar-identifier,kind=chartdefinition]", "value": "british-1752"},
    {"command": "key", "address": "resource.recipe.field[field=calendar-identifier,kind=chartdefinition]", "key": "Enter"},
    {"command": "select", "address": "resource.recipe.field[field=timezone,kind=chartdefinition]", "value": "named_zone"},
    {"command": "wait"},
    {"command": "click", "address": "resource.recipe.field[field=timezone-value,kind=chartdefinition]"},
    {"command": "set", "address": "resource.recipe.field[field=timezone-value,kind=chartdefinition]", "value": "America/New_York"},
    {"command": "key", "address": "resource.recipe.field[field=timezone-value,kind=chartdefinition]", "key": "Enter"},
    {"command": "select", "address": "resource.recipe.field[field=disambiguation,kind=chartdefinition]", "value": "later"},
    {"command": "set", "address": "resource.recipe.field[field=location-name,kind=chartdefinition]", "value": "Transit location"},
    {"command": "set", "address": "resource.recipe.field[field=country-region,kind=chartdefinition]", "value": "US-MD"},
    {"command": "set", "address": "resource.recipe.field[field=atlas-provider,kind=chartdefinition]", "value": "Cockpit Atlas"},
    {"command": "set", "address": "resource.recipe.field[field=atlas-record,kind=chartdefinition]", "value": "md-001"},
    {"command": "set", "address": "resource.recipe.field[field=atlas-version,kind=chartdefinition]", "value": "2027a"},
    {"command": "select", "address": "resource.recipe.field[field=calculation-zodiac,kind=chartdefinition]", "value": "sidereal"},
    {"command": "wait"},
    {"command": "click", "address": "resource.recipe.field[field=calculation-ayanamsha,kind=chartdefinition]"},
    {"command": "set", "address": "resource.recipe.field[field=calculation-ayanamsha,kind=chartdefinition]", "value": "lahiri"},
    {"command": "key", "address": "resource.recipe.field[field=calculation-ayanamsha,kind=chartdefinition]", "key": "Enter"},
    {"command": "select", "address": "resource.recipe.field[field=calculation-houses,kind=chartdefinition]", "value": "equal"},
    {"command": "select", "address": "resource.recipe.field[field=calculation-coordinates,kind=chartdefinition]", "value": "topocentric"},
    {"command": "select", "address": "resource.recipe.field[field=calculation-lunar-node,kind=chartdefinition]", "value": "mean"},
    {"command": "select", "address": "resource.recipe.field[field=calculation-black-moon,kind=chartdefinition]", "value": "osculating"},
    {"command": "select", "address": "resource.recipe.field[field=calculation-fortune,kind=chartdefinition]", "value": "always"},
    {"command": "check", "address": "resource.recipe.field[field=calculation-aberration,kind=chartdefinition]", "value": true},
    {"command": "check", "address": "resource.recipe.field[field=calculation-light-time,kind=chartdefinition]", "value": true},
    {"command": "check", "address": "resource.recipe.field[field=calculation-nutation,kind=chartdefinition]", "value": true},
    {"command": "click", "address": "resource.save[kind=chartdefinition]"},
    {"command": "wait", "timeout": 20},

    {"command": "click", "address": "resource.new[kind=chartdefinition]"},
    {"command": "set", "address": "resource.title[kind=chartdefinition]", "value": "Cockpit Harmonic"},
    {"command": "select", "address": "resource.recipe.field[field=type,kind=chartdefinition]", "value": "harmonic"},
    {"command": "wait"},
    {"command": "click", "address": "resource.recipe.field[field=harmonic,kind=chartdefinition]"},
    {"command": "set", "address": "resource.recipe.field[field=harmonic,kind=chartdefinition]", "value": "not-a-number"},
    {"command": "key", "address": "resource.recipe.field[field=harmonic,kind=chartdefinition]", "key": "Enter"},
    {"command": "get", "address": "resource.save[kind=chartdefinition]", "expect": {"enabled": false, "disabled_reason": "Correct invalid local resource values before saving"}},
    {"command": "key", "address": "resource.recipe.field[field=harmonic,kind=chartdefinition]", "key": "Escape"},
    {"command": "click", "address": "resource.recipe.field[field=harmonic,kind=chartdefinition]"},
    {"command": "set", "address": "resource.recipe.field[field=harmonic,kind=chartdefinition]", "value": "0"},
    {"command": "key", "address": "resource.recipe.field[field=harmonic,kind=chartdefinition]", "key": "Enter"},
    {"command": "wait"},
    {"command": "get", "address": "resource.save[kind=chartdefinition]", "expect": {"enabled": false, "disabled_reason": "Complete every invalid resource field before saving"}},
    {"command": "click", "address": "resource.recipe.field[field=harmonic,kind=chartdefinition]"},
    {"command": "set", "address": "resource.recipe.field[field=harmonic,kind=chartdefinition]", "value": "3"},
    {"command": "key", "address": "resource.recipe.field[field=harmonic,kind=chartdefinition]", "key": "Enter"},
    {"command": "wait"},
    {"command": "click", "address": "resource.save[kind=chartdefinition]"},
    {"command": "wait", "timeout": 20},

    {"command": "click", "address": "resource.new[kind=chartdefinition]"},
    {"command": "set", "address": "resource.title[kind=chartdefinition]", "value": "Cockpit Relocation"},
    {"command": "select", "address": "resource.recipe.field[field=type,kind=chartdefinition]", "value": "relocation"},
    {"command": "wait"},
    {"command": "set", "address": "resource.recipe.field[field=location-name,kind=chartdefinition]", "value": "Washington"},
    {"command": "click", "address": "resource.recipe.field[field=latitude,kind=chartdefinition]"},
    {"command": "set", "address": "resource.recipe.field[field=latitude,kind=chartdefinition]", "value": "38.9072"},
    {"command": "key", "address": "resource.recipe.field[field=latitude,kind=chartdefinition]", "key": "Enter"},
    {"command": "click", "address": "resource.recipe.field[field=longitude,kind=chartdefinition]"},
    {"command": "set", "address": "resource.recipe.field[field=longitude,kind=chartdefinition]", "value": "-77.0369"},
    {"command": "key", "address": "resource.recipe.field[field=longitude,kind=chartdefinition]", "key": "Enter"},
    {"command": "set", "address": "resource.recipe.field[field=country-region,kind=chartdefinition]", "value": "US-DC"},
    {"command": "click", "address": "resource.save[kind=chartdefinition]"},
    {"command": "wait", "timeout": 20},

    {"command": "click", "address": "resource.new[kind=chartdefinition]"},
    {"command": "set", "address": "resource.title[kind=chartdefinition]", "value": "Cockpit Composite"},
    {"command": "select", "address": "resource.recipe.field[field=type,kind=chartdefinition]", "value": "composite"},
    {"command": "wait"},
    {"command": "select", "address": "resource.recipe.field[field=method,kind=chartdefinition]", "value": "davison"},
    {"command": "click", "address": "resource.list.insert[collection=composite-charts,kind=chartdefinition]"},
    {"command": "wait"},
    {"command": "discover", "control": "resource.recipe.field", "qualifiers": {"kind": "chartdefinition", "collection": "composite-charts", "field": "resource"}, "index": 2, "bind": "third_composite_chart"},
    {"command": "get", "address": "${third_composite_chart}"},
    {"command": "click", "address": "resource.save[kind=chartdefinition]"},
    {"command": "wait", "timeout": 20},
    {"command": "reload"},
    {"command": "wait", "timeout": 20},
    {"command": "snapshot", "expect": {"value.application.status": "ready", "value.application.settled": true}}
  ]
}
