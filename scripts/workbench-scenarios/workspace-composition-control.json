{
  "name": "workspace-composition-control",
  "steps": [
    {"command": "wait", "timeout": 15},
    {"command": "click", "address": "resource.new[kind=viewdocument]"},
    {"command": "set", "address": "resource.title[kind=viewdocument]", "value": "Browser composition view"},
    {"command": "click", "address": "resource.save[kind=viewdocument]"},
    {"command": "wait", "timeout": 15},
    {"command": "click", "address": "workspace.load-demo"},
    {"command": "wait", "timeout": 15},
    {"command": "click", "address": "workspace.open[resource=14000000-0000-4000-8000-000000000001]"},
    {"command": "click", "address": "workspace.switch-discard"},
    {"command": "wait", "timeout": 15},
    {"command": "discover", "control": "workspace.view.add", "bind": "add_view"},
    {"command": "click", "address": "${add_view}"},
    {"command": "wait", "timeout": 15},
    {"command": "discover", "control": "workspace.view.rotation", "index": 1, "bind": "rotation"},
    {"command": "click", "address": "${rotation}"},
    {"command": "set", "address": "${rotation}", "value": "42.5"},
    {"command": "key", "address": "${rotation}", "key": "Enter"},
    {"command": "wait", "timeout": 15},
    {"command": "discover", "control": "workspace.view.point", "qualifiers": {"point": "sun"}, "index": 1, "bind": "hidden_sun"},
    {"command": "check", "address": "${hidden_sun}", "value": true},
    {"command": "wait", "timeout": 15},
    {"command": "discover", "control": "workspace.view.move", "index": 0, "bind": "move_original_view"},
    {"command": "click", "address": "${move_original_view}"},
    {"command": "discover", "control": "workspace.chart.add", "bind": "add_chart"},
    {"command": "click", "address": "${add_chart}"},
    {"command": "wait", "timeout": 15},
    {"command": "discover", "control": "workspace.chart.move", "index": 0, "bind": "move_original_chart"},
    {"command": "click", "address": "${move_original_chart}"},
    {"command": "click", "address": "workspace.save"},
    {"command": "wait", "timeout": 15},
    {"command": "reload"},
    {"command": "wait", "timeout": 15},
    {"command": "click", "address": "workspace.open[resource=14000000-0000-4000-8000-000000000001]"},
    {"command": "click", "address": "workspace.switch-discard"},
    {"command": "wait", "timeout": 15},
    {"command": "get", "address": "${rotation}", "expect": {"value": "42.5", "invalid": false}},
    {"command": "get", "address": "${hidden_sun}", "expect": {"value": true}},
    {"command": "discover", "control": "workspace.view.remove", "index": 1, "bind": "remove_original_view"},
    {"command": "click", "address": "${remove_original_view}"},
    {"command": "click", "address": "workspace.save"},
    {"command": "wait", "timeout": 15},
    {"command": "trace"}
  ]
}
