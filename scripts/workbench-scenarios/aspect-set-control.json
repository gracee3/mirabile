{
  "name": "aspect-set-control",
  "steps": [
    {"command": "wait", "timeout": 15},
    {"command": "click", "address": "workspace.load-demo"},
    {"command": "wait", "timeout": 15},
    {"command": "click", "address": "workspace.open"},
    {"command": "click", "address": "workspace.switch-discard"},
    {"command": "wait", "timeout": 15},
    {"command": "click", "address": "aspect.edit"},
    {"command": "get", "address": "aspect.maximum-orb[aspect=conjunction]", "expect": {"enabled": true}},
    {"command": "get", "address": "aspect.maximum-orb[aspect=square]", "expect": {"enabled": true}},
    {"command": "click", "address": "aspect.maximum-orb[aspect=square]"},
    {"command": "set", "address": "aspect.maximum-orb[aspect=square]", "value": "999"},
    {"command": "get", "address": "aspect.maximum-orb[aspect=square]", "expect": {"invalid": true, "local_buffer": "999"}},
    {"command": "get", "address": "draft.save[surface=editor]", "expect": {"enabled": false}},
    {"command": "set", "address": "aspect.maximum-orb[aspect=square]", "value": "4.5"},
    {"command": "key", "address": "aspect.maximum-orb[aspect=square]", "key": "Enter"},
    {"command": "check", "address": "aspect.enabled[aspect=conjunction]", "value": false},
    {"command": "click", "address": "aspect.title"},
    {"command": "set", "address": "aspect.title", "value": "Browser Full Row Set"},
    {"command": "key", "address": "aspect.title", "key": "Enter"},
    {"command": "click", "address": "draft.save[surface=editor]"},
    {"command": "wait", "timeout": 15},
    {"command": "click", "address": "aspect.maximum-orb[aspect=square]"},
    {"command": "get", "address": "aspect.maximum-orb[aspect=square]", "expect": {"value": "4.5"}},
    {"command": "key", "address": "aspect.maximum-orb[aspect=square]", "key": "Escape"},
    {"command": "get", "address": "aspect.enabled[aspect=conjunction]", "expect": {"value": false}},
    {"command": "click", "address": "aspect.duplicate"},
    {"command": "click", "address": "draft.save[surface=editor]"},
    {"command": "wait", "timeout": 15},
    {"command": "snapshot", "expect": {"value.workspace.dirty": true, "value.application.settled": true}},
    {"command": "trace"}
  ]
}
