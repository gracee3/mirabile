{
  "name": "aspect-set-control",
  "steps": [
    {"command": "wait", "timeout": 15},
    {"command": "click", "address": "workspace.load-demo"},
    {"command": "wait", "timeout": 15},
    {"command": "click", "address": "workspace.open"},
    {"command": "click", "address": "workspace.switch-discard"},
    {"command": "wait", "timeout": 15},
    {"command": "click", "address": "aspect.edit"},
    {"command": "get", "address": "aspect.maximum-orb[aspect=conjunction]", "expect": {"enabled": true}},
    {"command": "get", "address": "aspect.maximum-orb[aspect=square]", "expect": {"enabled": true}},
    {"command": "click", "address": "aspect.maximum-orb[aspect=square]"},
    {"command": "set", "address": "aspect.maximum-orb[aspect=square]", "value": "999"},
    {"command": "get", "address": "aspect.maximum-orb[aspect=square]", "expect": {"invalid": true, "local_buffer": "999"}},
    {"command": "get", "address": "draft.save[surface=editor]", "expect": {"enabled": false}},
    {"command": "set", "address": "aspect.maximum-orb[aspect=square]", "value": "4.5"},
    {"command": "key", "address": "aspect.maximum-orb[aspect=square]", "key": "Enter"},
    {"command": "click", "address": "aspect.angle[aspect=square]"},
    {"command": "set", "address": "aspect.angle[aspect=square]", "value": "not-an-angle"},
    {"command": "key", "address": "aspect.angle[aspect=square]", "key": "Enter"},
    {"command": "get", "address": "aspect.angle[aspect=square]", "expect": {"invalid": true, "editing": true, "local_buffer": "not-an-angle"}},
    {"command": "get", "address": "draft.save[surface=editor]", "expect": {"enabled": false, "disabled_reason": "Correct invalid local values before saving"}},
    {"command": "key", "address": "aspect.angle[aspect=square]", "key": "Escape"},
    {"command": "click", "address": "aspect.angle[aspect=square]"},
    {"command": "set", "address": "aspect.angle[aspect=square]", "value": "91"},
    {"command": "key", "address": "aspect.angle[aspect=square]", "key": "Enter"},
    {"command": "click", "address": "aspect.applying-multiplier[aspect=square]"},
    {"command": "set", "address": "aspect.applying-multiplier[aspect=square]", "value": "1.2"},
    {"command": "key", "address": "aspect.applying-multiplier[aspect=square]", "key": "Enter"},
    {"command": "check", "address": "aspect.enabled[aspect=conjunction]", "value": false},
    {"command": "click", "address": "aspect.title"},
    {"command": "set", "address": "aspect.title", "value": "Browser Full Row Set"},
    {"command": "key", "address": "aspect.title", "key": "Enter"},
    {"command": "set", "address": "aspect.description", "value": "Aspect browser metadata"},
    {"command": "set", "address": "aspect.tags", "value": "duplicate, duplicate"},
    {"command": "wait"},
    {"command": "get", "address": "draft.save[surface=editor]", "expect": {"enabled": false, "disabled_reason": "Complete every invalid Aspect Set field before saving"}},
    {"command": "set", "address": "aspect.tags", "value": "aspects, browser"},
    {"command": "wait"},
    {"command": "click", "address": "draft.save[surface=editor]"},
    {"command": "wait", "timeout": 15},
    {"command": "click", "address": "aspect.maximum-orb[aspect=square]"},
    {"command": "get", "address": "aspect.maximum-orb[aspect=square]", "expect": {"value": "4.5"}},
    {"command": "key", "address": "aspect.maximum-orb[aspect=square]", "key": "Escape"},
    {"command": "get", "address": "aspect.angle[aspect=square]", "expect": {"value": "91"}},
    {"command": "get", "address": "aspect.applying-multiplier[aspect=square]", "expect": {"value": "1.2"}},
    {"command": "get", "address": "aspect.enabled[aspect=conjunction]", "expect": {"value": false}},
    {"command": "get", "address": "aspect.description", "expect": {"value": "Aspect browser metadata"}},
    {"command": "get", "address": "aspect.tags", "expect": {"value": "aspects, browser"}},
    {"command": "click", "address": "aspect.duplicate"},
    {"command": "get", "address": "aspect.description", "expect": {"value": "Aspect browser metadata"}},
    {"command": "get", "address": "aspect.tags", "expect": {"value": "aspects, browser"}},
    {"command": "click", "address": "draft.save[surface=editor]"},
    {"command": "wait", "timeout": 15},
    {"command": "snapshot", "expect": {"value.workspace.dirty": true, "value.application.settled": true}},
    {"command": "trace"}
  ]
}
